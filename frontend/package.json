{
  "name": "dms-ai-document-search",
  "version": "0.1.0",
  "description": "Multi-Tenant AI Document Search Desktop Client",
  "author": "DMS Team <admin@example.com>",
  "homepage": "https://github.com/example/dms",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop:dev": "electron .",
    "desktop:build": "BUILD_TARGET=desktop next build && electron-builder --linux AppImage deb",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "build": {
    "appId": "com.dms.desktop",
    "productName": "DMS AI Document Search",
    "executableName": "dms-search",
    "icon": "public/stark-icon.png",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "out/**/*",
      "public/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "DMS Team <admin@example.com>",
      "category": "Office"
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^1.6.0",
    "lucide-react": "^0.300.0",
    "mammoth": "^1.8.0",
    "next": "14",
    "react": "^18",
    "react-dom": "^18",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8",
    "eslint-config-next": "14",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
