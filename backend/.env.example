# ─── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_URL=postgresql+asyncpg://docsearch:change_me_in_production@postgres:5432/docsearch

# ─── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379/0

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AWS S3 ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-docsearch-bucket
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# ─── AI Providers ───────────────────────────────────────────
# Provider selection:
# AI_LLM_PROVIDER: ollama | groq | openai | anthropic
# AI_EMBED_PROVIDER: bgem3 | ollama | openai | gemini | cohere
# AI_RERANK_PROVIDER: bge | cohere | none
# AI_OCR_PROVIDER: pdfplumber | pytesseract | llamaparse
AI_LLM_PROVIDER=ollama
AI_EMBED_PROVIDER=bgem3
AI_EMBED_FALLBACK_PROVIDER=none
AI_RERANK_PROVIDER=bge
AI_OCR_PROVIDER=pdfplumber

# Local Inferencing (Ollama, BGE Reranker, Tesseract)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.3
OLLAMA_EMBED_MODEL=bge-m3
LOCAL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
TESSERACT_CMD=tesseract

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536

# Anthropic (alternative LLM)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

# Groq (cloud LLM)
GROQ_API_KEY=gsk_...
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Cohere (reranker)
COHERE_API_KEY=your_cohere_api_key
COHERE_RERANK_MODEL=rerank-english-v3.0

# LlamaParse (alternative OCR — requires API key)
LLAMAPARSE_API_KEY=llx-...

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_USER=60/minute
RATE_LIMIT_PER_TENANT=1000/minute
